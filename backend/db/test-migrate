#!/bin/sh
# Self-test for backend/db/migrate.
#
# Starts the compose PostgreSQL service if needed, then exercises the runner
# against a disposable database with a unique name (tg_migself_<pid>_<random>_test)
# and temporary migration files. The tradegrid database and the real
# backend/db/migrations directory are never touched. The database is dropped
# on exit, including after Ctrl-C.
#
# TRADEGRID_SELFTEST_SHELL runs the runner under a given shell instead of its
# #! line, for example: TRADEGRID_SELFTEST_SHELL=dash dash backend/db/test-migrate
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
MIGRATE="$ROOT/backend/db/migrate"
SH=${TRADEGRID_SELFTEST_SHELL:-}
TEST_DB=tg_migself_$$_$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')_test
# A database that must survive a malicious drop-test-db name.
VICTIM=${TEST_DB%_test}_victim
TMP=
BAK=
BG=
export TRADEGRID_DB_NAME=$TEST_DB

migrate() {
	${SH:+"$SH"} "$MIGRATE" "$@"
}

# admin SQL runs one statement in the maintenance database.
admin() {
	docker compose -f "$ROOT/compose.yaml" exec -T postgres \
		sh -c 'exec psql -X -q -At -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d postgres -c "$1"' psql "$1" </dev/null
}

cleanup() {
	trap - EXIT HUP INT TERM
	for pid in $BG; do
		kill "$pid" 2>/dev/null || true
	done
	wait 2>/dev/null || true
	if [ -n "$BAK" ] && [ -e "$BAK/started" ]; then
		migrate drop-test-db "$TEST_DB" >/dev/null 2>&1 ||
			echo "warning: could not drop $TEST_DB; run: backend/db/migrate drop-test-db $TEST_DB" >&2
		admin "DROP DATABASE IF EXISTS $VICTIM WITH (FORCE)" >/dev/null 2>&1 ||
			echo "warning: could not drop $VICTIM" >&2
	fi
	rm -rf "$TMP" "$BAK"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

TMP=$(mktemp -d)
BAK=$(mktemp -d)
export TRADEGRID_MIGRATIONS_DIR=$TMP

fail() {
	echo "FAIL: $*" >&2
	exit 1
}
pass() { echo "ok: $*"; }

compose() {
	docker compose -f "$ROOT/compose.yaml" "$@"
}

query() {
	compose exec -T postgres \
		sh -c 'db=$1; shift; exec psql -X -q -At -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$db" "$@"' psql "$TEST_DB" -c "$1" </dev/null
}

# fingerprint prints a digest of a full schema and data dump of the test
# database. Equal fingerprints mean no object, row, or tracking entry changed.
# pg_dump's per-run \restrict key is removed first.
fingerprint() {
	compose exec -T postgres sh -c 'pg_dump -U "$POSTGRES_USER" -d "$1"' sh "$TEST_DB" </dev/null >"$BAK/dump" ||
		fail "pg_dump failed"
	sed -e '/^\\restrict /d' -e '/^\\unrestrict /d' "$BAK/dump" | cksum
}

reset_db() {
	migrate drop-test-db "$TEST_DB" >/dev/null
	migrate create-test-db "$TEST_DB" >/dev/null
	rm -f "$TMP"/*.sql
}

sha() {
	if command -v sha256sum >/dev/null 2>&1; then sha256sum <"$1"; else shasum -a 256 <"$1"; fi | cut -d ' ' -f 1
}

# expect_untouched LABEL FILE runs up with FILE as the only pending
# migration and requires it to fail without changing the database at all.
expect_untouched() {
	label=$1
	before=$(fingerprint)
	if migrate up </dev/null >"$BAK/out" 2>&1; then fail "$label: up reported success: $(cat "$BAK/out")"; fi
	[ "$(fingerprint)" = "$before" ] || fail "$label: failed migration changed the database"
	rm -f "$2"
}

# Malformed names are refused before any SQL runs. These checks need no
# database: a stand-in docker on PATH records every call, and none may happen.
FAKE="$BAK/fake-bin"
mkdir "$FAKE"
cat >"$FAKE/docker" <<'EOF'
#!/bin/sh
echo "$*" >>"${0%/*}/calls"
exit 99
EOF
chmod +x "$FAKE/docker"

# refused LABEL ARGS... runs the runner with the stand-in docker and requires
# it to refuse ARGS without calling docker.
refused() {
	r_label=$1
	shift
	rm -f "$FAKE/calls"
	if (PATH="$FAKE:$PATH" && migrate "$@") >"$BAK/out" 2>&1; then fail "$r_label: accepted"; fi
	[ ! -e "$FAKE/calls" ] || fail "$r_label: called docker before refusing: $(cat "$FAKE/calls")"
	grep -Eq '^migrate: (refusing|bad migration file name|usage)' "$BAK/out" || fail "$r_label: $(cat "$BAK/out")"
}

# The stand-in must see valid names, or the checks below prove nothing.
rm -f "$FAKE/calls"
(PATH="$FAKE:$PATH" && migrate drop-test-db ok_test) >/dev/null 2>&1 || true
[ -s "$FAKE/calls" ] || fail "the stand-in docker was not called for a valid name"

nl='
'
tab=$(printf '\t')
cr=$(printf '\r')
long64=$(printf 'a%.0s' $(seq 1 59))_test
n=0
# "victim;<newline>x_test" passed the old line-by-line grep check and dropped
# the database "victim".
for name in "victim;${nl}x_test" "x_test${nl}" "${nl}x_test" "x_test${nl}victim" "victim x_test" \
	"x_test " " x_test" "x${tab}_test" "x${cr}_test" "x_test;" "x;y_test" "x'y_test" 'x"y_test' \
	'x\y_test' 'x$y_test' 'x-y_test' 'x.y_test' 'x*_test' 'x(y)_test' 'x_test--' 'X_test' 'x_TEST' \
	'_x_test' '1x_test' '_test' 'x_test_' 'xtest' 'x_testx' '' "$(printf '\303\251_test')" "$long64" \
	"x_test; DROP DATABASE tradegrid" tradegrid postgres; do
	n=$((n + 1))
	refused "drop-test-db '$name'" drop-test-db "$name"
	refused "create-test-db '$name'" create-test-db "$name"
done
refused "drop-test-db without a name" drop-test-db
refused "drop-test-db with two names" drop-test-db a_test b_test
pass "test database commands refuse $n malformed names before any SQL runs"

n=0
for name in "tradegrid${nl}x" "host=127.0.0.1 dbname=tradegrid" "postgresql://tradegrid@127.0.0.1/tradegrid" \
	Tradegrid 'trade grid' 'a;b' "a'b" '1db' "$(printf 'a%.0s' $(seq 1 64))"; do
	n=$((n + 1))
	(TRADEGRID_DB_NAME=$name && refused "TRADEGRID_DB_NAME '$name' (status)" status) || exit 1
	(TRADEGRID_DB_NAME=$name && refused "TRADEGRID_DB_NAME '$name' (up)" up) || exit 1
done
pass "up and status refuse $n malformed TRADEGRID_DB_NAME values before any SQL runs"

n=0
for name in "0001_a.sql${nl}0002_b.sql" "0001_a.sql${nl}" '0001_a b.sql' '0001_a;b.sql' "0001_a'b.sql" \
	'0001_a$b.sql' '0001_a*.sql' '0001_A.sql' '0001_.sql' '001_a.sql' '00001_a.sql' '0001-a.sql' \
	'0001_a.SQL' '0001_a.sql.bak' "$(printf '0001_\303\251.sql')"; do
	n=$((n + 1))
	rm -rf "$BAK/names"
	mkdir "$BAK/names"
	echo "SELECT 1;" >"$BAK/names/$name"
	(TRADEGRID_MIGRATIONS_DIR=$BAK/names && refused "migration file '$name' (status)" status) || exit 1
	(TRADEGRID_MIGRATIONS_DIR=$BAK/names && refused "migration file '$name' (up)" up) || exit 1
done
rm -rf "$BAK/names"
pass "up and status refuse $n malformed migration file names before any SQL runs"

compose up -d --wait postgres >/dev/null
: >"$BAK/started"
echo "test database: $TEST_DB"
reset_db

# Migrations apply in version order, exactly once, and each is recorded with
# the checksum of the file that ran.
cat >"$TMP/0002_add_label.sql" <<'SQL'
-- Function bodies may contain BEGIN/END/COMMIT; only top-level transaction
-- control is rejected.
ALTER TABLE selftest_widgets ADD COLUMN label text NOT NULL DEFAULT 'none';
CREATE FUNCTION selftest_label(w selftest_widgets) RETURNS text
LANGUAGE plpgsql AS $$
BEGIN
	-- COMMIT; \q
	RETURN upper(w.label);
END;
$$;
SQL
cat >"$TMP/0001_create_widgets.sql" <<'SQL'
CREATE TABLE selftest_widgets (id integer PRIMARY KEY);
INSERT INTO selftest_widgets (id) VALUES (1);
SQL
migrate up >/dev/null || fail "first up"
[ "$(query "SELECT string_agg(version, ',' ORDER BY applied_at, version) FROM schema_migrations")" = "0001,0002" ] ||
	fail "versions not recorded in order"
for f in 0001_create_widgets.sql 0002_add_label.sql; do
	[ "$(query "SELECT checksum FROM schema_migrations WHERE name = '$f'")" = "$(sha "$TMP/$f")" ] ||
		fail "$f recorded with the wrong checksum"
done
pass "applies pending migrations in version order with their checksums"

out=$(migrate up) || fail "second up"
echo "$out" | grep -q "ran 0 pending" || fail "rerun applied something: $out"
[ "$(query "SELECT count(*) FROM selftest_widgets")" = 1 ] || fail "rerun duplicated data"
[ "$(query "SELECT selftest_label(w) FROM selftest_widgets w")" = NONE ] || fail "function migration"
pass "rerunning up is a no-op"

out=$(migrate status) || fail "status on clean history"
echo "$out" | grep -q "^applied   0001_create_widgets.sql" || fail "status: $out"
pass "status reports applied migrations"

# Valid SQL that only looks like transaction control or metacommands.
cat >"$TMP/0003_lookalikes.sql" <<'SQL'
CREATE TABLE selftest_words (begin_at int, "end" int, note text);
COMMENT ON TABLE selftest_words IS 'COMMIT; ROLLBACK; \q';
INSERT INTO selftest_words (note) VALUES (E'it\'s; COMMIT'), ($tag$ END; \set $tag$); /* nested /* COMMIT; */ \q */
CREATE FUNCTION selftest_sign(x int) RETURNS int LANGUAGE sql
BEGIN ATOMIC
	SELECT CASE WHEN x > 0 THEN 1 WHEN x < 0 THEN -1 ELSE 0 END;
END;
CREATE PROCEDURE selftest_noop() LANGUAGE plpgsql AS $$ BEGIN NULL; END $$;
DO $$ BEGIN PERFORM selftest_sign(1); END $$
SQL
migrate up >/dev/null || fail "valid look-alike migration was rejected"
[ "$(query "SELECT selftest_sign(-5) || ':' || count(*) FROM selftest_words")" = "-1:2" ] ||
	fail "look-alike migration did not apply"
pass "accepts function bodies, BEGIN ATOMIC, and quoted look-alikes"

# A failing migration reports failure and leaves no change behind: not its
# table, not its row changes, not a tracking row.
cat >"$TMP/0004_broken.sql" <<'SQL'
CREATE TABLE selftest_broken (id integer);
INSERT INTO selftest_widgets (id) VALUES (2);
UPDATE selftest_widgets SET label = 'changed';
ALTER TABLE selftest_widgets ADD COLUMN extra int;
SELECT 1 / 0;
SQL
before=$(fingerprint)
if migrate up >/dev/null 2>&1; then fail "broken migration reported success"; fi
[ "$(fingerprint)" = "$before" ] || fail "broken migration changed the database"
migrate status | grep -q "^pending   0004_broken.sql" || fail "broken migration not pending"
rm "$TMP/0004_broken.sql"
pass "failed migration exits non-zero and leaves the database unchanged"

# Transaction control is rejected before any SQL runs. Each file changes
# data first, so a commit that slipped through would show in the dump.
n=0
while IFS= read -r stmt; do
	n=$((n + 1))
	f="$TMP/0004_txn_$n.sql"
	printf 'CREATE TABLE selftest_leak (id int);\nINSERT INTO selftest_widgets (id) VALUES (99);\n%s\n' "$stmt" >"$f"
	expect_untouched "transaction control '$stmt'" "$f"
	grep -q 'transaction control' "$BAK/out" || fail "'$stmt' not reported as transaction control: $(cat "$BAK/out")"
done <<'EOF'
COMMIT;
commit
END;
END TRANSACTION;
ROLLBACK;
ABORT;
BEGIN;
START TRANSACTION;
SAVEPOINT s; ROLLBACK TO SAVEPOINT s;
RELEASE SAVEPOINT s;
PREPARE TRANSACTION 'x';
COMMIT AND CHAIN;
COMMIT PREPARED 'x';
/* comment */ COMMIT;
SELECT 1; COMMIT; SELECT 2;
COMMIT; BEGIN; SELECT set_config('tradegrid.migration', '0004_txn.sql', true);
EOF
pass "rejects $n forms of transaction control with no database change"

# psql metacommands are rejected before any SQL runs. \! would create a file
# in the container if it ever ran.
marker=/tmp/tg_selftest_$$
n=0
while IFS= read -r stmt; do
	n=$((n + 1))
	f="$TMP/0004_meta_$n.sql"
	printf 'CREATE TABLE selftest_leak (id int);\n%s\nSELECT 1 / 0;\n' "$stmt" >"$f"
	expect_untouched "metacommand '$stmt'" "$f"
	grep -q 'metacommand' "$BAK/out" || fail "'$stmt' not reported as a metacommand: $(cat "$BAK/out")"
done <<EOF
\\set ON_ERROR_STOP off
\\q
\\quit
\\! touch $marker
\\i /dev/null
\\connect postgres
\\if false
SELECT 'COMMIT' \\gexec
\\o /dev/null
\\copy selftest_widgets to stdout
EOF
if compose exec -T postgres test -e "$marker" </dev/null; then fail "\\! ran a shell command"; fi
pass "rejects $n psql metacommands with no database change"

# Malformed files are rejected before any SQL runs.
printf 'CREATE TABLE selftest_leak (id int);\nSELECT $x$ COMMIT;\n' >"$TMP/0004_dollar.sql"
expect_untouched "unterminated dollar quote" "$TMP/0004_dollar.sql"
printf "CREATE TABLE selftest_leak (id int);\nSELECT 'COMMIT;\n" >"$TMP/0004_quote.sql"
expect_untouched "unterminated string" "$TMP/0004_quote.sql"
printf -- '-- nothing here\n' >"$TMP/0004_empty.sql"
expect_untouched "empty migration" "$TMP/0004_empty.sql"
printf 'CREATE TABLE selftest_leak (id int);\0COMMIT;\n' >"$TMP/0004_nul.sql"
expect_untouched "NUL byte" "$TMP/0004_nul.sql"
pass "rejects unterminated quotes, empty files, and NUL bytes"

# One bad file stops the run before an earlier good file is applied.
echo "CREATE TABLE selftest_good (id int);" >"$TMP/0004_good.sql"
printf 'CREATE TABLE selftest_leak (id int);\nCOMMIT;\n' >"$TMP/0005_bad.sql"
expect_untouched "preflight" "$TMP/0005_bad.sql"
rm "$TMP/0004_good.sql"
pass "checks every pending file before applying any"

# An unreadable file fails instead of being recorded as applied. Skipped as
# root, which can read it anyway.
echo "CREATE TABLE selftest_unreadable (id int);" >"$TMP/0004_unreadable.sql"
chmod 000 "$TMP/0004_unreadable.sql"
if [ -r "$TMP/0004_unreadable.sql" ]; then
	rm -f "$TMP/0004_unreadable.sql"
	echo "skip: unreadable migration (running as root)"
else
	expect_untouched "unreadable file" "$TMP/0004_unreadable.sql"
	pass "unreadable migration fails and records nothing"
fi

# The server enforces the same rules if the static check is bypassed: the
# file runs through EXECUTE, which refuses transaction control, and psql never
# sees metacommands.
export TRADEGRID_MIGRATE_SELFTEST_SKIP_CHECK=1
n=0
while IFS= read -r stmt; do
	n=$((n + 1))
	f="$TMP/0004_server_$n.sql"
	printf 'CREATE TABLE selftest_leak (id int);\nINSERT INTO selftest_widgets (id) VALUES (99);\n%s\n' "$stmt" >"$f"
	expect_untouched "server guard '$stmt'" "$f"
done <<EOF
COMMIT;
END;
ROLLBACK; CREATE TABLE selftest_after (id int);
COMMIT; BEGIN; SELECT set_config('tradegrid.migration', '0004_server.sql', true);
SAVEPOINT s;
DO \$\$ BEGIN COMMIT; END \$\$;
\\set ON_ERROR_STOP off
\\q
\\! touch $marker
EOF
unset TRADEGRID_MIGRATE_SELFTEST_SKIP_CHECK
if compose exec -T postgres test -e "$marker" </dev/null; then fail "\\! ran a shell command"; fi
pass "server rejects $n bypass attempts even without the static check"

# Losing the connection mid-migration fails and leaves nothing behind.
printf 'CREATE TABLE selftest_leak (id int);\nSELECT pg_sleep(60);\n' >"$TMP/0004_killed.sql"
before=$(fingerprint)
migrate up >"$BAK/killed.log" 2>&1 &
BG=$!
i=0
until [ "$(query "SELECT pg_terminate_backend(pid) FROM pg_stat_activity
                 WHERE datname = current_database() AND pid <> pg_backend_pid() AND query LIKE '%pg_sleep(60)%'")" = t ]; do
	i=$((i + 1))
	[ $i -lt 100 ] || fail "migration never started"
	sleep 0.2
done
if wait "$BG"; then fail "up reported success after its connection was killed"; fi
BG=
[ "$(fingerprint)" = "$before" ] || fail "killed migration changed the database"
rm "$TMP/0004_killed.sql"
pass "killed connection fails and leaves the database unchanged"

# Interruption. SIGINT must stop the migration on the server too, and the
# runner must report only an outcome it has verified. A non-interactive shell
# starts background jobs with SIGINT ignored, so the runner runs in the
# foreground and a background helper sends the signal to it alone.
#
# interrupt CONDITION [PATH] runs up, with PATH if given, and sends SIGINT to
# the runner once a session in the test database matches CONDITION (SQL over
# pg_stat_activity). It leaves the output in $BAK/int.log, the exit status in
# $int_status, and the duration in $int_secs. The helper creates
# $BAK/int.signalled just before signalling.
interrupt() {
	: >"$BAK/int.pid"
	rm -f "$BAK/int.signalled"
	(
		i=0
		until [ -s "$BAK/int.pid" ] &&
			[ "$(query "SELECT count(*) FROM pg_stat_activity
			            WHERE datname = current_database() AND pid <> pg_backend_pid() AND $1")" = 1 ]; do
			i=$((i + 1))
			[ $i -lt 150 ] || exit 1
			sleep 0.2
		done
		: >"$BAK/int.signalled"
		kill -INT "$(cat "$BAK/int.pid")"
	) &
	BG=$!
	int_start=$(date +%s)
	int_status=0
	env PATH="${2:-$PATH}" sh -c 'echo "$$" >"$1"; shift; exec "$@"' sh "$BAK/int.pid" ${SH:+"$SH"} "$MIGRATE" up \
		</dev/null >"$BAK/int.log" 2>&1 || int_status=$?
	int_secs=$(($(date +%s) - int_start))
	wait "$BG" || fail "the migration never started: $(cat "$BAK/int.log")"
	BG=
	[ "$int_status" = 130 ] || fail "interrupted up exited $int_status, not 130: $(cat "$BAK/int.log")"
	[ "$int_secs" -lt 30 ] || fail "interrupted up took ${int_secs}s to stop"
}

# no_session waits until no server session is still running a migration.
no_session() {
	i=0
	until [ "$(query "SELECT count(*) FROM pg_stat_activity
	                  WHERE datname = current_database() AND pid <> pg_backend_pid()
	                    AND application_name LIKE 'tradegrid-migrate-%'")" = 0 ]; do
		i=$((i + 1))
		[ $i -lt 50 ] || fail "a migration session is still running"
		sleep 0.2
	done
}

if sh -c 'trap "exit 0" INT; kill -INT $$; sleep 1; exit 1' 2>/dev/null; then
	# Before COMMIT: the server session is terminated at once, and the
	# runner reports the migration as not applied only after checking.
	printf 'CREATE TABLE selftest_leak (id int);\nSELECT pg_sleep(60);\n' >"$TMP/0004_interrupted.sql"
	before=$(fingerprint)
	interrupt "query LIKE '%pg_sleep(60)%'"
	grep -q "0004_interrupted.sql was not applied: COMMIT was never sent" "$BAK/int.log" ||
		fail "interrupted before COMMIT: $(cat "$BAK/int.log")"
	if grep -q "rolled back" "$BAK/int.log"; then fail "claimed a rollback: $(cat "$BAK/int.log")"; fi
	no_session
	[ "$(fingerprint)" = "$before" ] || fail "interrupted migration changed the database"
	migrate status 2>/dev/null | grep -q "^pending   0004_interrupted.sql" || fail "interrupted migration not pending"
	rm "$TMP/0004_interrupted.sql"
	pass "SIGINT before COMMIT stops the server session and reports the verified outcome"

	# During COMMIT: a deferred trigger keeps the commit running. The
	# runner may not know whether it finished, so it stops the session and
	# checks schema_migrations.
	cat >"$TMP/0004_slow_commit.sql" <<'SQL'
CREATE TABLE selftest_slow_commit (id int);
CREATE FUNCTION selftest_slow_commit() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
	PERFORM pg_sleep(60);
	RETURN NULL;
END;
$$;
CREATE CONSTRAINT TRIGGER selftest_slow_commit AFTER INSERT ON selftest_slow_commit
	DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION selftest_slow_commit();
INSERT INTO selftest_slow_commit (id) VALUES (1);
SQL
	before=$(fingerprint)
	interrupt "application_name LIKE 'tradegrid-migrate-%' AND state = 'active' AND query LIKE 'COMMIT;%'"
	grep -q "0004_slow_commit.sql was not applied: its server session ended without committing" "$BAK/int.log" ||
		fail "interrupted during COMMIT: $(cat "$BAK/int.log")"
	no_session
	[ "$(fingerprint)" = "$before" ] || fail "migration interrupted during COMMIT changed the database"
	rm "$TMP/0004_slow_commit.sql"
	pass "SIGINT during COMMIT stops the server session and reports the verified outcome"

	# When the server cannot be checked, the outcome is reported as
	# unknown. A docker wrapper starts failing once the signal is sent.
	mkdir "$BAK/flaky-bin"
	cat >"$BAK/flaky-bin/docker" <<EOF
#!/bin/sh
[ ! -e "$BAK/int.signalled" ] || exit 1
exec $(command -v docker) "\$@"
EOF
	chmod +x "$BAK/flaky-bin/docker"
	printf 'CREATE TABLE selftest_leak (id int);\nSELECT pg_sleep(60);\n' >"$TMP/0004_unknown.sql"
	before=$(fingerprint)
	interrupt "query LIKE '%pg_sleep(60)%'" "$BAK/flaky-bin:$PATH"
	grep -q "the outcome of 0004_unknown.sql is unknown. Run .*backend/db/migrate status" "$BAK/int.log" ||
		fail "unverifiable interruption: $(cat "$BAK/int.log")"
	if grep -Eq "was not applied|was committed" "$BAK/int.log"; then
		fail "claimed an outcome it could not check: $(cat "$BAK/int.log")"
	fi
	query "SELECT pg_terminate_backend(pid) FROM pg_stat_activity
	       WHERE datname = current_database() AND pid <> pg_backend_pid() AND query LIKE '%pg_sleep(60)%'" >/dev/null
	no_session
	[ "$(fingerprint)" = "$before" ] || fail "unverified migration was committed"
	rm "$TMP/0004_unknown.sql"
	rm -rf "$BAK/flaky-bin"
	pass "SIGINT reports an unknown outcome when the server cannot be checked"
else
	echo "skip: interruption tests (SIGINT is ignored in this environment)"
fi

# History must match the files.
cp "$TMP/0001_create_widgets.sql" "$BAK/0001.sql"
echo "-- edited" >>"$TMP/0001_create_widgets.sql"
if migrate status >/dev/null 2>&1; then fail "status ignored a modified migration"; fi
migrate status 2>/dev/null | grep -q "^MODIFIED  0001_create_widgets.sql" || fail "status did not flag MODIFIED"
if migrate up >/dev/null 2>&1; then fail "up ran with a modified migration"; fi
mv "$BAK/0001.sql" "$TMP/0001_create_widgets.sql"
pass "modified applied migrations block status and up"

mv "$TMP/0002_add_label.sql" "$BAK/0002.sql"
if migrate up >/dev/null 2>&1; then fail "up ran with a missing migration"; fi
migrate status 2>/dev/null | grep -q "^MISSING   0002_add_label.sql" || fail "status did not flag MISSING"
mv "$BAK/0002.sql" "$TMP/0002_add_label.sql"
pass "missing applied migrations block status and up"

# Versions cannot be applied out of order or reused, and names are checked.
echo "SELECT 1;" >"$TMP/0000_late.sql"
if migrate up >/dev/null 2>&1; then fail "applied a version older than the latest"; fi
migrate status 2>/dev/null | grep -q "^BLOCKED   0000_late.sql" || fail "status did not flag BLOCKED"
rm "$TMP/0000_late.sql"
echo "SELECT 1;" >"$TMP/0002_duplicate.sql"
if migrate up >/dev/null 2>&1; then fail "accepted a reused version"; fi
rm "$TMP/0002_duplicate.sql"
echo "SELECT 1;" >"$TMP/4_Bad-Name.sql"
if migrate up >/dev/null 2>&1; then fail "accepted a bad file name"; fi
rm "$TMP/4_Bad-Name.sql"
printf 'SELECT 1;\nCOMMIT;\n' >"$TMP/0009_invalid.sql"
if migrate status >/dev/null 2>&1; then fail "status accepted an invalid pending migration"; fi
migrate status 2>/dev/null | grep -q "^INVALID   0009_invalid.sql" || fail "status did not flag INVALID"
rm "$TMP/0009_invalid.sql"
migrate status >/dev/null || fail "status after restoring files"
pass "rejects out-of-order versions, reused versions, bad names, and invalid files"

# Concurrent runs apply a migration once and all succeed.
reset_db
cat >"$TMP/0001_slow.sql" <<'SQL'
SELECT pg_sleep(1);
CREATE TABLE selftest_slow (id integer);
SQL
echo "CREATE TABLE selftest_after_slow (id integer);" >"$TMP/0002_after.sql"
pids=
for r in a b c; do
	migrate up >"$BAK/$r.log" 2>&1 &
	pids="$pids $!"
done
BG=$pids
for pid in $pids; do
	wait "$pid" || fail "concurrent run failed: $(cat "$BAK"/?.log)"
done
BG=
[ "$(query "SELECT string_agg(version, ',' ORDER BY version) FROM schema_migrations")" = "0001,0002" ] ||
	fail "concurrent runs recorded the wrong history"
[ "$(cat "$BAK"/?.log | grep -c '^applying  0001_slow.sql')" -ge 1 ] || fail "no run applied 0001"
pass "concurrent runs apply each migration once"

# The ordering and conflict checks are repeated under the lock. A helper
# session holds the migration lock until a runner is waiting for it, then
# records a row the runner did not see when it read history.
race() {
	row=$1
	compose exec -T postgres sh -c 'exec psql -X -q -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$1"' sh "$TEST_DB" >/dev/null <<SQL &
SELECT pg_advisory_lock(hashtext('tradegrid.migrate'));
DO \$\$
DECLARE started timestamptz := clock_timestamp();
BEGIN
	WHILE NOT EXISTS (SELECT 1 FROM pg_locks WHERE locktype = 'advisory' AND NOT granted
	                  AND database = (SELECT oid FROM pg_database WHERE datname = current_database())) LOOP
		IF clock_timestamp() - started > interval '30 seconds' THEN
			RAISE EXCEPTION 'no runner waited for the lock';
		END IF;
		PERFORM pg_sleep(0.05);
	END LOOP;
END
\$\$;
INSERT INTO schema_migrations (version, name, checksum) VALUES $row;
SELECT pg_advisory_unlock(hashtext('tradegrid.migrate'));
SQL
	helper=$!
	BG=$helper
	migrate up >"$BAK/race.log" 2>&1
	race_status=$?
	wait "$helper" || fail "lock helper failed"
	BG=
	return $race_status
}

echo "CREATE TABLE selftest_race (id integer);" >"$TMP/0003_race.sql"
if race "('0004', '0004_elsewhere.sql', repeat('0', 64))"; then
	fail "applied 0003 after a concurrent run recorded 0004"
fi
grep -q "older than the latest applied version 0004" "$BAK/race.log" || fail "race: $(cat "$BAK/race.log")"
[ "$(query "SELECT to_regclass('selftest_race') IS NULL")" = t ] || fail "out-of-order migration ran"
query "DELETE FROM schema_migrations WHERE version = '0004'" >/dev/null
pass "out-of-order check holds against a concurrent run"

if race "('0003', '0003_race.sql', repeat('0', 64))"; then
	fail "accepted version 0003 recorded with another checksum"
fi
grep -q "already recorded for a different file or checksum" "$BAK/race.log" || fail "race: $(cat "$BAK/race.log")"
[ "$(query "SELECT to_regclass('selftest_race') IS NULL")" = t ] || fail "conflicting migration ran"
query "DELETE FROM schema_migrations WHERE version = '0003'" >/dev/null
pass "conflicting concurrent version is rejected"

race "('0003', '0003_race.sql', '$(sha "$TMP/0003_race.sql")')" || fail "race skip: $(cat "$BAK/race.log")"
grep -q "skipping  0003_race.sql" "$BAK/race.log" || fail "race skip: $(cat "$BAK/race.log")"
[ "$(query "SELECT to_regclass('selftest_race') IS NULL")" = t ] || fail "skipped migration ran"
pass "identical concurrent version is skipped, not rerun"

# up confirms each tracking row from a new connection after the commit, so a
# row that does not match the file that ran is reported.
reset_db
cat >"$TMP/0001_tamper.sql" <<'SQL'
CREATE FUNCTION selftest_tamper() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
	NEW.checksum := 'tampered';
	RETURN NEW;
END;
$$;
CREATE TRIGGER selftest_tamper BEFORE INSERT ON schema_migrations
	FOR EACH ROW EXECUTE FUNCTION selftest_tamper();
SQL
if migrate up >"$BAK/out" 2>&1; then fail "up accepted a tracking row with the wrong checksum"; fi
grep -q "not recorded in schema_migrations with checksum" "$BAK/out" || fail "tamper: $(cat "$BAK/out")"
if migrate status >/dev/null 2>&1; then fail "status accepted a tampered checksum"; fi
pass "up and status detect a tracking row that does not match the file"

# The name checks hold against a real server: the name that dropped
# "victim" before is refused and the database survives, and the longest
# allowed name works.
admin "CREATE DATABASE $VICTIM" >/dev/null
if migrate drop-test-db "$VICTIM;${nl}x_test" >"$BAK/out" 2>&1; then fail "drop-test-db accepted a newline"; fi
[ "$(admin "SELECT count(*) FROM pg_database WHERE datname = '$VICTIM'")" = 1 ] ||
	fail "drop-test-db dropped $VICTIM: $(cat "$BAK/out")"
admin "DROP DATABASE $VICTIM" >/dev/null
long63=${TEST_DB%_test}
while [ ${#long63} -lt 58 ]; do long63=${long63}x; done
long63=${long63}_test
migrate create-test-db "$long63" >/dev/null || fail "create-test-db refused a 63-byte name"
[ "$(admin "SELECT datname FROM pg_database WHERE datname = '$long63'")" = "$long63" ] ||
	fail "63-byte name was not created as given"
migrate drop-test-db "$long63" >/dev/null || fail "drop-test-db refused a 63-byte name"
[ "$(admin "SELECT count(*) FROM pg_database WHERE datname = '$long63'")" = 0 ] || fail "63-byte name was not dropped"
pass "drop-test-db cannot reach other databases, and 63-byte names work end to end"

echo "all migration self-tests passed"
