# Copy to .env (untracked) to override the local PostgreSQL defaults in
# compose.yaml. These values are for a local development container only and
# are not secrets; never put real credentials here.
POSTGRES_USER=tradegrid
POSTGRES_PASSWORD=tradegrid-local-only
POSTGRES_DB=tradegrid
# Host port for PostgreSQL. Change it if something else already uses 5432.
TRADEGRID_DB_PORT=5432
