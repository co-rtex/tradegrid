CREATE INDEX executions_sell_order_id_idx ON public.executions USING btree (sell_order_id)
CREATE INDEX executions_seller_symbol_sequence_idx ON public.executions USING btree (seller_user_id, symbol, sequence DESC)
CREATE UNIQUE INDEX executions_sequence_key ON public.executions USING btree (sequence)
CREATE INDEX executions_symbol_sequence_idx ON public.executions USING btree (symbol, sequence DESC)
CREATE UNIQUE INDEX instruments_pkey ON public.instruments USING btree (symbol)
