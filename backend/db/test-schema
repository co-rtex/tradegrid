CREATE UNIQUE INDEX orders_sequence_key ON public.orders USING btree (sequence)
CREATE INDEX orders_user_id_sequence_idx ON public.orders USING btree (user_id, sequence DESC)
CREATE UNIQUE INDEX positions_pkey ON public.positions USING btree (user_id, symbol)"

# The planned reads can use their focused indexes. Sequential scans are
# disabled because the tables are tiny and a scan would otherwise win.
plan=$(query "SET enable_seqscan = off; EXPLAIN (COSTS OFF) $(account_orders bob)")
echo "$plan" | grep -q "orders_user_id_sequence_idx" || fail "account orders do not use orders_user_id_sequence_idx:
$plan"
plan=$(query "SET enable_seqscan = off; EXPLAIN (COSTS OFF) $(execution_history AAPL NULL)")
echo "$plan" | grep -q "executions_symbol_sequence_idx" || fail "symbol executions do not use executions_symbol_sequence_idx:
$plan"
pass "indexes match the design; account-order and symbol-execution reads use them"

# ---------------------------------------------------------------------------
# Seeds

out=$("$SEED") || fail "first seed"
echo "$out" | grep -q "^seeded $TEST_DB\$" || fail "seed: $out"
expect_seed_state "first seed"
pass "seed loads exactly the demo accounts, balances, and symbols, with no orders or executions"

before=$(fingerprint)
"$SEED" >/dev/null || fail "second seed"
"$SEED" >/dev/null || fail "third seed"
[ "$(fingerprint)" = "$before" ] || fail "rerunning the seed changed the database"
expect_seed_state "rerun seed"
pass "rerunning the seed changes nothing: no duplicate rows, no added balances"

# A rerun never resets balances that trading has since changed.
query "UPDATE accounts SET cash_total = 10190000 WHERE user_id = 'alice';
	UPDATE positions SET total = 90 WHERE user_id = 'alice' AND symbol = 'AAPL'" >/dev/null
"$SEED" >/dev/null || fail "seed after a balance change"
expect "balances after rerun" "SELECT (SELECT cash_total FROM accounts WHERE user_id = 'alice') || ','
	|| (SELECT total FROM positions WHERE user_id = 'alice' AND symbol = 'AAPL') || ','
	|| (SELECT count(*) FROM accounts) || ',' || (SELECT count(*) FROM positions)" "10190000,90,2,4"
pass "rerunning the seed keeps changed balances as they are"

# Seeding is all or nothing: a failing seed file, or one that tries to
# commit early, leaves no row behind, including rows from earlier files.
empty_db
"$MIGRATE" up >/dev/null || fail "migrate up"
mkdir "$TMP/seeds"
cp "$ROOT/backend/db/seeds"/*.sql "$TMP/seeds/"
for broken in "INSERT INTO instruments (symbol, name) VALUES ('TSLA', 'Tesla, Inc.');
SELECT 1 / 0;" "INSERT INTO instruments (symbol, name) VALUES ('TSLA', 'Tesla, Inc.');
COMMIT;
INSERT INTO instruments (symbol, name) VALUES ('NVDA', 'NVIDIA Corporation');"; do
	printf '%s\n' "$broken" >"$TMP/seeds/9999_broken.sql"
	before=$(fingerprint)
	if TRADEGRID_SEEDS_DIR=$TMP/seeds "$SEED" >"$TMP/out" 2>&1; then fail "broken seed reported success"; fi
	[ "$(fingerprint)" = "$before" ] || fail "failed seed changed the database: $(cat "$TMP/out")"
done
expect "after failed seeds" "SELECT (SELECT count(*) FROM accounts) + (SELECT count(*) FROM instruments)" 0
pass "a failing seed file, or one that commits early, changes nothing"

# ---------------------------------------------------------------------------
# Example 3 from docs/database-schema.md (fixture 03): partial fill.
# Alice's SELL 10 AAPL at $190.00 rests; Bob buys 25 at $190.50; 10 fill at
# $190.00 and 15 rest with a retained reservation of 19050 x 15 = 285750.

seeded_db
psql_db >/dev/null <<SQL || fail "loading Example 3"
