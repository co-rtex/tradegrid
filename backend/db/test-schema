	('ord-1', 1, 'alice', 'AAPL', 'SELL', 'LIMIT', 19000, 10, 0, 'FILLED', '2026-10-20T15:00:01Z', '2026-10-20T15:00:02Z'),
	('ord-2', 2, 'bob', 'AAPL', 'BUY', 'LIMIT', 19050, 25, 15, 'PARTIALLY_FILLED', '2026-10-20T15:00:02Z', '2026-10-20T15:00:02Z');
INSERT INTO executions ($EXEC_COLS) VALUES
	('exe-1', 1, '2026-10-20T15:00:02Z', 'AAPL', 19000, 10, 'ord-2', 'ord-1', 'bob', 'alice');
UPDATE accounts SET cash_total = 10190000 WHERE user_id = 'alice';
UPDATE accounts SET cash_total = 9810000, cash_reserved = 285750 WHERE user_id = 'bob';
UPDATE positions SET total = 90 WHERE user_id = 'alice' AND symbol = 'AAPL';
UPDATE positions SET total = 110 WHERE user_id = 'bob' AND symbol = 'AAPL';
SQL

echo "sample queries, Example 3 (partial fill):"
show "execution with both counterparties" "$COUNTERPARTIES_Q"
show "bob's orders, newest first" "$(account_orders bob)"
show "AAPL execution history, newest first" "$(execution_history AAPL NULL)"
